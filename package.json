{
  "name": "eyadati-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "عيادتي - نظام إدارة عيادات أسنان يعمل على Windows كتطبيق Desktop",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k -p \"[{name}]\" -n \"vite,electron\" -c \"cyan,magenta\" \"vite --port 3000 --host 0.0.0.0\" \"wait-on tcp:3000 && electron -r tsx/cjs electron/main.ts\"",
    "dev:vite": "vite --port 3000 --host 0.0.0.0",
    "dev:electron": "wait-on tcp:3000 && electron -r tsx/cjs electron/main.ts",
    "build": "vite build && npm run build:electron",
    "build:electron": "node scripts/build-electron.js && tsc -p tsconfig.electron.json",
    "build:win": "npm run rebuild:sqlite && npm run build && electron-builder --win --x64",
    "postinstall": "node scripts/postinstall.js",
    "rebuild:sqlite": "electron-rebuild -f -w better-sqlite3",
    "lint": "tsc --noEmit",
    "test": "npx tsx --test src/lib/zatcaQr.test.ts src/app/routeStatus.test.ts electron/repositories/__tests__/devCredentials.test.ts electron/repositories/__tests__/security_audit_rbac.test.ts electron/repositories/__tests__/first_run_setup.test.ts electron/repositories/__tests__/license_core.test.ts electron/repositories/__tests__/reports_filters.test.ts electron/repositories/__tests__/ipc_schema_coverage.test.ts electron/repositories/__tests__/transactions.test.ts",
    "test:security": "npx tsx --test electron/repositories/__tests__/security_audit_rbac.test.ts",
    "test:db": "npx tsx --test electron/repositories/__tests__/transactions.test.ts",
    "test:setup": "npx tsx --test electron/repositories/__tests__/first_run_setup.test.ts",
    "test:license": "npx tsx --test electron/repositories/__tests__/license_core.test.ts",
    "test:reports": "npx tsx --test electron/repositories/__tests__/reports_filters.test.ts",
    "test:ipc": "npx tsx --test electron/repositories/__tests__/ipc_schema_coverage.test.ts",
    "license:gen-keys": "node tools/license-keygen.mjs gen-keys",
    "license:issue": "node tools/license-keygen.mjs issue",
    "license:inspect": "node tools/license-keygen.mjs inspect"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tanstack/react-query": "^5.62.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.38.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "node-cron": "^4.6.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.30.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-rtl": "^0.9.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vite": "^5.4.11",
    "vitest": "^5.0.1",
    "wait-on": "^8.0.1"
  }
}
